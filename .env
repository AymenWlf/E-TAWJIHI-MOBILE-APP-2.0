# Variables Expo accessibles côté client (préfixe obligatoire EXPO_PUBLIC_).
# Modifier ce fichier puis redémarrer Metro : `npx expo start --clear`.
#
# ──────────────────────────────────────────────────────────────────────
# API Backend (boutique, écoles, auth, etc.)
# ──────────────────────────────────────────────────────────────────────
# En dev, l'app détecte AUTOMATIQUEMENT la bonne base :
#   • Web / iOS simulator : http://localhost:8001
#   • Android emulator    : http://10.0.2.2:8001
#   • Device physique     : http://<IP_LAN_DU_MAC>:8001  (récupérée via Metro)
#
# Tu n'as donc en théorie RIEN à configurer ici en dev. Décommente seulement
# si tu veux forcer une URL (ex. tester directement la prod, ou un tunnel).
#
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
# Forcer une IP si besoin (iPhone physique, même Wi‑Fi que le Mac) :
# EXPO_PUBLIC_API_BASE_URL=http://192.168.100.167:8001
# Ancienne IP hotspot — ne plus utiliser :
# EXPO_PUBLIC_API_BASE_URL=http://172.20.10.4:8001
# Production — à activer uniquement pour tester la prod ou via EAS (eas.json env).
# En dev local, laisser commenté : l'app utilise localhost / IP Metro automatiquement.
# EXPO_PUBLIC_API_BASE_URL=https://apinew.e-tawjihi.ma
EXPO_PUBLIC_EAS_PROJECT_ID=8607d592-f821-41d9-a62e-75c4c190d41e
#
# Vide = auto (IP Metro, ex. 192.168.100.167:8001). Redémarrer : npx expo start --clear

# Surcharge le port par défaut (8001) si Symfony tourne ailleurs (8000, 8002, …).
# EXPO_PUBLIC_API_PORT=8001

# ──────────────────────────────────────────────────────────────────────
# Médias (uploads d'images depuis le backend)
# ──────────────────────────────────────────────────────────────────────
# Si vide, on s'aligne sur EXPO_PUBLIC_API_BASE_URL (auto‑détecté en dev).
# EXPO_PUBLIC_MEDIA_BASE_URL=

# Push Expo (obligatoire pour les notifications natives en dev client / EAS Build).
# Obtenir l'UUID via : npx eas init  (ou dashboard expo.dev → Project settings)
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# WhatsApp officiel E-Tawjihi (mot de passe oublié) — indicatif sans +
# EXPO_PUBLIC_ETAWJIHI_WHATSAPP_WA_DIGITS=212784536246
# Support transfert compte (affichage + WhatsApp)
# EXPO_PUBLIC_ETAWJIHI_TRANSFER_SUPPORT_PHONE=0655690632

# WhatsApp support / bulle flottante (06 55 69 06 32)
EXPO_PUBLIC_ETAWJIHI_SUPPORT_WHATSAPP_WA_DIGITS=212655690632
